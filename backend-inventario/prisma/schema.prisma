// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id           Int      @id @default(autoincrement())
  nombre       String
  precio       Float
  categoria    String
  fotoBase64   String?  // ¡La clave para las fotos de la cámara!
  codigoBarras String?  // Campo opcional para escaneo QR/código de barras
  createdAt    DateTime @default(now())
}
